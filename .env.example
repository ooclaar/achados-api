# Copie para .env e ajuste. O arquivo .env nunca vai para o repositório (.gitignore).
# Os valores abaixo servem apenas para desenvolvimento local.

# API
PORT=3000
LOG_LEVEL=info

# Postgres (usado pelo docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=achados
DB_PORT=5432

# Usado por `npm run dev` e pelos testes de integração fora do Compose
DATABASE_URL=postgres://postgres:postgres@localhost:5432/achados
